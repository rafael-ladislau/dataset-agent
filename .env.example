# Environment Variables for Dataset Agent

# Logging Configuration
DATASET_AGENT_LOG_LEVEL=INFO
DATASET_AGENT_LOG_FILE=dataset_agent.log
DATASET_AGENT_OUTPUT_DIR=./output

# LLM Configuration
DATASET_AGENT_LLM_PROVIDER=ollama  # or openrouter
DATASET_AGENT_LLM_MODEL=llama3  # or specify another model name
DATASET_AGENT_URL=http://localhost:11434

# OpenRouter API Configuration (if using openrouter provider)
OPENROUTER_API_KEY=your_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Web Search Configuration
WEB_SEARCH_PROVIDER=duckduckgo  # or tavily
TAVILY_API_KEY=your_tavily_api_key_here

# API Keys
API_KEYS=your_api_keys_here
