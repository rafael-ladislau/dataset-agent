# LLM (choose one provider)
DATASET_AGENT_LLM_PROVIDER=ollama
# URL do Ollama: no host com API via `uvicorn` local, use 127.0.0.1. Com API no Docker Compose, o compose força host.docker.internal (ignorar 127.0.0.1 aqui para esse caso).
DATASET_AGENT_OLLAMA_BASE_URL=http://127.0.0.1:11434
DATASET_AGENT_OLLAMA_MODEL=llama3:8b
DATASET_AGENT_OPENROUTER_API_KEY=
DATASET_AGENT_OPENROUTER_MODEL=

# API server
# Logs da app (dataset_agent.*): DEBUG, INFO, WARNING…
LOG_LEVEL=INFO
DATASET_AGENT_TASKS_DB=./tasks.db
DATASET_AGENT_OUTPUT_DIR=./output

# Literature gate (optional; requires: pip install -e ".[dimensions]")
# Set to "dimensions" to enable validation against Dimensions API
DATASET_AGENT_LITERATURE_GATE=noop
DATASET_AGENT_LITERATURE_MAX_ATTEMPTS=3
DATASET_AGENT_LITERATURE_THRESHOLD=0.5
# API key from https://app.dimensions.ai (Account > API)
DATASET_AGENT_DIMENSIONS_API_KEY=
